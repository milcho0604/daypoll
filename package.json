{
  "name": "whenever",
  "version": "0.0.1",
  "private": true,
  "description": "회원가입 없이 링크 하나로 날짜를 맞추는 웹앱",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @whenever/api dev",
    "dev:web": "pnpm --filter @whenever/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "test": "bash scripts/test.sh",
    "test:api": "pnpm --filter @whenever/api test:e2e",
    "test:web": "bash scripts/web-smoke.sh",
    "blog:new": "pnpm --filter @whenever/web blog:new",
    "blog:check": "pnpm --filter @whenever/web blog:check",
    "blog:preview": "pnpm --filter @whenever/web blog:preview"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "ws": ">=8.21.0",
      "multer": ">=2.2.0",
      "form-data": ">=4.0.6",
      "js-yaml": "4.3.1",
      "socket.io-parser": "4.2.7",
      "fast-uri": "3.1.5",
      "nanoid": "3.3.18",
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "minimatch@>=10.0.0>brace-expansion": "5.0.9"
    }
  }
}
